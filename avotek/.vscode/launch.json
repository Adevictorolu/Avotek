{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Avotek Web (Chrome)",
            "cwd": "${workspaceFolder}/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "chrome",
                "--web-hostname",
                "127.0.0.1",
                "--web-port",
                "8000"
            ]
        },
        {
            "name": "Avotek Web (Chrome, shared host)",
            "cwd": "${workspaceFolder}/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "chrome",
                "--web-hostname",
                "0.0.0.0",
                "--web-port",
                "8000"
            ]
        },
        {
            "name": "Avotek Web (Edge)",
            "cwd": "${workspaceFolder}/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "edge",
                "--web-hostname",
                "127.0.0.1",
                "--web-port",
                "8000"
            ]
        },
        {
            "name": "Avotek Mobile (Android / iOS)",
            "cwd": "${workspaceFolder}/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart"
        },
        {
            "name": "Avotek Web Server (Browser-Independent)",
            "cwd": "${workspaceFolder}/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "-d",

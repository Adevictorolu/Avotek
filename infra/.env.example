# =================================================================
# AVOTEK VTU PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================

# --- SERVERPOD RUNTIME CONFIGURATION ---
SERVERPOD_RUNMODE=development # development | staging | production
SERVERPOD_PORT=8080
SERVERPOD_WEB_PORT=8082
SERVERPOD_INSIGHTS_PORT=8081

# --- DATABASE CONFIGURATION (PostgreSQL 15+) ---
SERVERPOD_DATABASE_HOST=localhost
SERVERPOD_DATABASE_PORT=5432
SERVERPOD_DATABASE_NAME=avotek
SERVERPOD_DATABASE_USER=avotek_user
SERVERPOD_DATABASE_PASSWORD=avotek_secret_password

# --- REDIS CONFIGURATION ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_password

# --- PRIMARY VTU AGGREGATOR (VTpass) ---
# Register at https://vtpass.com
# Live API Base URL: https://api-service.vtpass.com/api
# Sandbox API Base URL: https://sandbox.vtpass.com/api
VTPASS_API_KEY=your_vtpass_api_key_here
VTPASS_PUBLIC_KEY=your_vtpass_public_key_here
VTPASS_SECRET_KEY=your_vtpass_secret_key_here
VTPASS_BASE_URL=https://sandbox.vtpass.com/api

# --- FALLBACK VTU AGGREGATOR (ClubKonnect) ---
# Register at https://www.clubkonnect.com
CK_USER_ID=your_clubkonnect_userid
CK_API_KEY=your_clubkonnect_apikey
CK_BASE_URL=https://www.clubkonnect.com/api

# --- VTUPRESS INTEGRATION (Optional / Direct WordPress API) ---
# If connecting directly through your VTUPress platform/reseller API:
VTUPRESS_URL=https://yourvtuwebsite.com
VTUPRESS_API_KEY=your_vtupress_api_key_here

# --- PAYMENT GATEWAY (Paystack Dedicated NUBAN Virtual Accounts) ---
# Register at https://paystack.com
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- WHATSAPP CLOUD API (Meta Graph API v18+) ---
# Developer portal: https://developers.facebook.com
WHATSAPP_TOKEN=EAAG...your_system_user_permanent_token
WHATSAPP_PHONE_NUMBER_ID=102938475610293
WHATSAPP_VERIFY_TOKEN=avotek_whatsapp_secure_verify_token_2026

# --- SMS NOTIFICATIONS (Termii Nigeria) ---
# Register at https://termii.com
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=AVOTEK
TERMII_BASE_URL=https://api.ng.termii.com/api

# --- AWS S3 STORAGE (Serverpod Storage Provider) ---
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=avotek-assets
AWS_REGION=eu-west-1

{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Avotek Web (Instant Run - Recommended)",
            "cwd": "${workspaceFolder}/avotek/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "noDebug": true,
            "args": [
                "-d",
                "chrome"
            ]
        },
        {
            "name": "Avotek Windows (Native Desktop App)",
            "cwd": "${workspaceFolder}/avotek/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "windows"
            ]
        },
        {
            "name": "Avotek Web (Chrome with Debugger)",
            "cwd": "${workspaceFolder}/avotek/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "chrome",
                "--web-browser-flag=--no-default-browser-check"
            ]
        },
        {
            "name": "Avotek Web (Edge Browser)",
            "cwd": "${workspaceFolder}/avotek/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "edge"
            ]
        },
        {
            "name": "Avotek Web Server",
            "cwd": "${workspaceFolder}/avotek/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "web-server",
                "--web-port",
                "8000"
            ]
        },
        {
            "name": "Avotek Mobile (Android)",
            "cwd": "${workspaceFolder}/avotek/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "android"
            ]
        },
        {
            "name": "Avotek Server (Serverpod Backend)",
            "cwd": "${workspaceFolder}/avotek/avotek_server",
            "request": "launch",
            "type": "dart",
            "program": "bin/main.dart"
        }
    ]
}

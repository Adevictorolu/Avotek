{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Avotek Web Chrome (Smooth, Fast & Never Shuts Off)",
            "cwd": "${workspaceFolder}/avotek/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "chrome"
            ]
        },
        {
            "name": "Avotek Web Server (Hot Reload - http://localhost:3000)",
            "cwd": "${workspaceFolder}/avotek/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "web-server",
                "--web-hostname",
                "127.0.0.1",
                "--web-port",
                "3000"
            ]
        },
        {
            "name": "Avotek Web Edge (Smooth, Fast & Never Shuts Off)",
            "cwd": "${workspaceFolder}/avotek/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "edge"
            ]
        },
        {
            "name": "Avotek Web Chrome (With Dart Debugger)",
            "cwd": "${workspaceFolder}/avotek/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "chrome",
                "--web-hostname",
                "127.0.0.1",
                "--web-port",
                "3000",
                "--web-browser-flag",
                "--remote-allow-origins=*"
            ]
        },
        {
            "name": "Avotek Web Server (http://localhost:3000 - Any Browser)",
            "cwd": "${workspaceFolder}/avotek/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "web-server",
                "--web-hostname",
                "127.0.0.1",
                "--web-port",
                "3000"
            ]
        },
        {
            "name": "Avotek Web Edge (Alternative Browser)",
            "cwd": "${workspaceFolder}/avotek/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "noDebug": true,
            "args": [
                "-d",
                "edge",
                "--web-hostname",
                "127.0.0.1",
                "--web-port",
                "3000"
            ]
        },
        {
            "name": "Avotek Mobile (Android)",
            "cwd": "${workspaceFolder}/avotek/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "android"
            ]
        },
        {
            "name": "Avotek Windows (Native Desktop - Requires VS C++)",
            "cwd": "${workspaceFolder}/avotek/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "windows"
            ]
        },
        {
            "name": "Avotek Server (Serverpod Backend)",
            "cwd": "${workspaceFolder}/avotek/avotek_server",
            "request": "launch",
            "type": "dart",
            "program": "bin/main.dart"
        }
    ]
}

{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Avotek Windows (Native Desktop - Fastest & Recommended)",
            "cwd": "${workspaceFolder}/avotek/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "windows"
            ]
        },
        {
            "name": "Avotek Web Server (No Timeout - http://localhost:8080)",
            "cwd": "${workspaceFolder}/avotek/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "web-server",
                "--web-port",
                "8080"
            ]
        },
        {
            "name": "Avotek Web Chrome (Run Without Debugging)",
            "cwd": "${workspaceFolder}/avotek/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "noDebug": true,
            "args": [
                "-d",
                "chrome",
                "--web-port",
                "8080"
            ]
        },
        {
            "name": "Avotek Web Edge (Alternative Browser)",
            "cwd": "${workspaceFolder}/avotek/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "edge"
            ]
        },
        {
            "name": "Avotek Mobile (Android)",
            "cwd": "${workspaceFolder}/avotek/avotek_flutter",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "android"
            ]
        },
        {
            "name": "Avotek Server (Serverpod Backend)",
            "cwd": "${workspaceFolder}/avotek/avotek_server",
            "request": "launch",
            "type": "dart",
            "program": "bin/main.dart"
        }
    ]
}
